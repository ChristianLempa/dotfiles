{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#1D1D1D",
    "--foreground": "#D1D1D1",
    "--card": "#171717",
    "--card-foreground": "#D1D1D1",
    "--popover": "#171717",
    "--popover-foreground": "#D1D1D1",
    "--primary": "#F1F1F1",
    "--primary-foreground": "#1D1D1D",
    "--secondary": "#292929",
    "--secondary-foreground": "#D1D1D1",
    "--muted": "#171717",
    "--muted-foreground": "#A7A7A7",
    "--accent": "#2F2F2F",
    "--accent-foreground": "#D1D1D1",
    "--border": "#3C3C3C",
    "--input": "#3C3C3C",
    "--ring": "#F1F1F1",
    "--sidebar": "#171717",
    "--sidebar-foreground": "#D1D1D1",
    "--sidebar-border": "#3C3C3C",
    "--editor-surface": "#1D1D1D"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#A7A7A7"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#E5A2FF"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#C29AFF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E5A2FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#73D7FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8CADFF"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D1D1D1"
      }
    }
  ]
}
